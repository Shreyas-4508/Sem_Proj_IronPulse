# Application Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ironpulse_db
DB_SSL=false

# JSON Web Token Secret & Expiry
JWT_SECRET=ironpulse_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=*
