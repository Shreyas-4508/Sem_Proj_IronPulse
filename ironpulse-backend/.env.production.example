# =============================================================================
# IronPulse Backend — Production Environment Variables
# =============================================================================
# This file is a REFERENCE ONLY — never committed with real secrets.
# Copy these key names into the Render Dashboard → Environment section.
# =============================================================================

# App
NODE_ENV=production
PORT=10000

# PostgreSQL (paste the full Neon/Render Postgres connection string)
# Get this from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT (Render can auto-generate this — use generateValue in render.yaml)
JWT_SECRET=GENERATE_A_STRONG_RANDOM_SECRET_HERE
JWT_EXPIRES_IN=7d

# CORS — your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://sem-proj-ironpulse.vercel.app
