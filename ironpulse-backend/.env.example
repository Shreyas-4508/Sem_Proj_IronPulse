# Application Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Settings
# In Production (Render / Neon / Supabase), provide the full DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# In Local Development (Discrete Parameters):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ironpulse_db
DB_SSL=false

# JSON Web Token Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL for Production CORS (e.g. Vercel)
FRONTEND_URL=https://semprojironpulse.vercel.app
